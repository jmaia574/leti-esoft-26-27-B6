@startuml
title US11 - Register a Parameter\nSequence Diagram (SD)

autoactivate on
autonumber

actor "Administrator" as User
participant ":ConsoleApp" as View
participant "service:RegisterParameter" as Service
participant "parameter:Parameter" as Parameter
participant "repository:ParameterRepository" as Repository

User -> View: asks to register a Parameter

View --> User: requests data (ID, name,\ndescription, metric)

User -> View: provides the requested data

View --> User: requests metric classification\n(Numeric or Qualitative)

User -> View: selects metric classification

opt Numeric metric
    View --> User: requests minimum and maximum\nreference values
    User -> View: provides both reference values
end

View -> Service: execute(ID, name, description,\nmetric, metricType, minimum, maximum)

Service -> Parameter**: create(ID, name, description,\nmetric, metricType, minimum, maximum)

Parameter -> Parameter: isValidID(ID)

Parameter -> Parameter: isValidReferenceRange(minimum, maximum)

note right of Parameter
Numeric:
Both reference values are mandatory.

Qualitative:
No numeric reference values.

minimum <= maximum
end note

Parameter --> Service: parameter

Service -> Repository: existsByID(ID)

Repository -> Repository: findByID(ID)

Repository --> Service: false

Service -> Repository: add(parameter)

Repository -> Repository: existsByID(ID)

Repository -> Repository: add parameter to collection

Repository --> Service: true

Service --> View: success

View --> User: informs operation success

@enduml