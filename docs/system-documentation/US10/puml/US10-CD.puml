@startuml
title US10 - Register a Test Type\nClass Diagram (CD)

hide circle
skinparam classAttributeIconSize 0

class RegisterTestTypeView {
}

class RegisterTestTypeController {
    +registerTestType(internalCode, nhsCode, collectionMethodDescription)
}

class App {
    - App()
    +{static} getInstance() : App
    +getTestTypeContainer() : TestTypeContainer
}

class TestTypeContainer {
    +create(internalCode, nhsCode, collectionMethodDescription) : TestType
    +save(testType) : bool
}

class TestType {
    -internalCode
    -nhsCode
    -collectionMethodDescription
    TestType(internalCode, nhsCode, collectionMethodDescription)
}

RegisterTestTypeView ..> RegisterTestTypeController
RegisterTestTypeController ..> App
RegisterTestTypeController .> TestTypeContainer
RegisterTestTypeController .> TestType

App -> "1" App : instance
App --> "1" TestTypeContainer : maintains
TestTypeContainer -> "  * " TestType : records

@enduml
