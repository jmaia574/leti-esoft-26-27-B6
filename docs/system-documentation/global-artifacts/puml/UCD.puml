@startuml
title UKLabsMS - Use Case Diagram

left to right direction

' ACTORS
actor Receptionist
actor "Medical Lab Technician" as LabTech
actor Client
actor "Specialist Doctor" as Doctor
actor "Clinical Chemistry Technologist" as CCT
actor "Administrator" as Admin
rectangle "«actor»\nBarcode Generation API" as BarcodeAPI
actor "Staff Member" as Staff


'USE CASES
rectangle "UKLabsMS" {
    usecase "UC01\nAuthenticate User" as UC_AuthenticateUser
    usecase "UC02\nManage Clinical Analysis Laboratories" as UC_Laboratories
    usecase "UC03\nManage Employees" as UC_Employees
    usecase "UC04\nManage Test Types" as UC_TestTypes
    usecase "UC05\nManage Parameters" as UC_Parameters
    usecase "UC06\nRegister Client" as UC_RegisterClient
    usecase "UC07\nRegister Prescribed Test" as UC_RegisterTest
    usecase "UC08\nRegister Sample" as UC_RegisterSample
    usecase "UC09\nObtain Sample Barcode" as UC_Barcode
    usecase "UC10\nRecord Chemical Analysis Results" as UC_RecordTestResults
    usecase "UC11\nPrepare Diagnostic Report" as UC_WriteDiagnosis
    usecase "UC12\nView Test Results and Report" as UC_ViewResults
}

'ASSOCIATION
Receptionist -- UC_RegisterClient
Receptionist -- UC_RegisterTest
LabTech -- UC_RegisterSample
CCT -- UC_RecordTestResults
Doctor -- UC_WriteDiagnosis
Client -- UC_ViewResults
Client -- UC_AuthenticateUser
Admin -- UC_TestTypes
Admin -- UC_Parameters
Admin -- UC_Laboratories
Admin -- UC_Employees
BarcodeAPI -- UC_Barcode
UC_RegisterSample ..> UC_Barcode : <<include>>
Staff -- UC_AuthenticateUser
Admin -- UC_AuthenticateUser
Staff <|-- Receptionist
Staff <|-- LabTech
Staff <|-- CCT
Staff <|-- Doctor

'NOTES
note right of UC_WriteDiagnosis
  After the specialist doctor completes
  the diagnosis report, the system
  notifies the client via SMS and/or e-mail.
end note

note right of UC_ViewResults
  Clients may only access their test
  results after the specialist doctor
  has completed the diagnosis report.
end note


@enduml