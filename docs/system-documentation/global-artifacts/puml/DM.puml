@startuml
' UKLabsMS - Sprint 1 conceptual domain model
' Multiplicities and modeling assumptions are justified in analysis.md.
title UKLabsMS - Domain Model

hide methods
hide circle
skinparam classAttributeIconSize 0

class Client {
    name
    citizenCardNumber
    nhsNumber
    birthDate
    sex
    taxIdentificationNumber
    phoneNumber
    email
}

class Administrator
class Receptionist
class MedicalLabTechnician
class ClinicalChemistryTechnologist
class SpecialistDoctor
class Courier

class ClinicalAnalysisLaboratory {
    code
    address
    phoneNumber
    email
    openingHour
    closingHour
}

class ChemicalLaboratory
class LabOrder

class RegisteredTest {
    dateOfPrescription
    sampleCollectionDate
}

class TestType {
    internalCode
    nhsCode
    collectionMethodDescription
}

class Parameter {
    code
    name
    description
    metric
}

class ReferenceRange {
    minimum
    maximum
}

class Sample {
    barcode
}

class ChemicalAnalysis

class ParameterResult {
    value
    recordedAt
}

class Diagnosis
class Report
class Notification

' Clients, prescriptions, tests and test definitions
Client "1" -- "0..*" LabOrder : submits >
Client "1" -- "0..*" RegisteredTest : is associated with >
Receptionist "1" -- "0..*" RegisteredTest : registers >

' Current simplifying assumption: one registered test per lab order
LabOrder "1" -- "1" RegisteredTest : corresponds to >
RegisteredTest "0..*" -- "1" TestType : is classified as >
ClinicalAnalysisLaboratory "1" -- "0..*" RegisteredTest : collects samples for >

' Assumption: parameters can be reused across test types;
' a catalogued parameter may exist before being assigned to a test type.
TestType "0..*" -- "1..*" Parameter : measures >
Parameter "1" -- "0..1" ReferenceRange : has >

' Registered tests may exist before any sample is collected.
RegisteredTest "1" -- "0..*" Sample : has >
MedicalLabTechnician "1" -- "0..*" Sample : registers >
' Optional until transported; courier tracking is a modeling assumption.
Courier "0..1" -- "0..*" Sample : transports >

' Assumption: the same sample may be analyzed more than once.
Sample "1" -- "0..*" ChemicalAnalysis : undergoes >
ChemicalLaboratory "1" -- "0..*" ChemicalAnalysis : hosts >
ClinicalChemistryTechnologist "1" -- "0..*" ChemicalAnalysis : performs >

ChemicalAnalysis "1" -- "1..*" ParameterResult : records >
Parameter "1" -- "0..*" ParameterResult : measured by >

RegisteredTest "1" -- "0..1" Report : results in >
Report "1" -- "1" Diagnosis : contains >
Report "1" -- "1..*" ParameterResult : presents >
SpecialistDoctor "1" -- "0..*" Report : prepares >

Client "1" -- "0..*" Notification : receives >
Notification "0..*" -- "1" Report : concerns >

' Management responsibility, not ownership by an individual administrator.
Administrator "0..*" -- "0..*" TestType : manages >
Administrator "0..*" -- "0..*" Parameter : manages >
Administrator "0..*" -- "0..*" ClinicalAnalysisLaboratory : manages >

@enduml
