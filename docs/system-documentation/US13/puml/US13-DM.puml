@startuml

title US13 - List Employees by Role\nDomain Model (DM)

' =====================================================
' Visual configuration
' =====================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBorderColor #2563EB
skinparam classBackgroundColor #EFF6FF
skinparam ArrowColor #475569
skinparam NoteBackgroundColor #FFF9E6
skinparam linetype ortho

hide methods
hide circle

' =====================================================
' Domain concepts
' =====================================================

class Administrator

class Employee {
    ID
    name
}

class Role {
    name
}

' =====================================================
' Domain relationships
' =====================================================

Administrator "1*" -- "0..*" Employee : consults >

Employee "0..*" -- "1" Role : is assigned to >



@enduml
